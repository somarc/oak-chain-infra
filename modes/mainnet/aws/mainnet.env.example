# Ethereum Mainnet Configuration
# Real blockchain verification with real ETH - USE WITH CAUTION!
#
# REQUIRED: Set your Infura API key before sourcing this file (never commit it):
#   export INFURA_API_KEY=your_infura_api_key_here

# Validate INFURA_API_KEY is set
if [ -z "${INFURA_API_KEY:-}" ]; then
    echo "❌ ERROR: INFURA_API_KEY not set"
    echo "   Then: export INFURA_API_KEY=your_key"
    return 1 2>/dev/null || exit 1
fi

export OAK_BLOCKCHAIN_MODE=mainnet
export OAK_BLOCKCHAIN_RPC_URL=https://mainnet.infura.io/v3/${INFURA_API_KEY}
export OAK_BLOCKCHAIN_CONTRACT_ADDRESS=0xTODO_DEPLOY_MAINNET_CONTRACT

# IPFS BlobStore (default, always enabled)
export BLOBSTORE_TYPE=ipfs
export IPFS_API_ENDPOINT=/ip4/127.0.0.1/tcp/5001

# WARNING: Mainnet uses real ETH!
# Ensure contract is thoroughly tested before deploying

