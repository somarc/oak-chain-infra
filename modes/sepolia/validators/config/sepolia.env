# Sepolia Testnet Configuration
# Real blockchain verification with test ETH.
#
# REQUIRED:
# - OAK_BLOCKCHAIN_RPC_URL
# - OAK_BLOCKCHAIN_CONTRACT_ADDRESS
#
# Optional convenience:
#   export INFURA_API_KEY=your_key
#   export OAK_BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/${INFURA_API_KEY}

export OAK_BLOCKCHAIN_MODE=sepolia

# Keep your actual deployed contract address here.
export OAK_BLOCKCHAIN_CONTRACT_ADDRESS=0x7fcEc350268F5482D04eb4B229A0679374906732

# If not already exported externally, build RPC URL from INFURA_API_KEY.
if [ -z "${OAK_BLOCKCHAIN_RPC_URL:-}" ] && [ -n "${INFURA_API_KEY:-}" ]; then
  export OAK_BLOCKCHAIN_RPC_URL="https://sepolia.infura.io/v3/${INFURA_API_KEY}"
fi

# IPFS BlobStore (default)
export BLOBSTORE_TYPE=ipfs
export IPFS_API_ENDPOINT=/ip4/127.0.0.1/tcp/5001
