# IPFS BlobStore Configuration (DEFAULT & ONLY)
# Decentralized binary storage via IPFS
# See ADR 015-020 for architecture

export BLOBSTORE_TYPE=ipfs
export IPFS_API_ENDPOINT=/ip4/127.0.0.1/tcp/5001
export IPFS_GATEWAY_BASE=https://ipfs.io/ipfs/
export IPFS_LOCAL_GATEWAY_BASE=http://127.0.0.1:5080/ipfs/

# REQUIRED: IPFS daemon must be running
#   Start: ipfs daemon
#   Check: curl -X POST http://127.0.0.1:5001/api/v0/version
#
# Architecture Notes:
#   - Structured content → Oak segments (TarMK)
#   - Binary content → IPFS (content-addressed)
#   - Validators store CIDs only (not binary data)
#   - Authors own binaries (upload on confirmation)
