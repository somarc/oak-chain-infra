# Sepolia Testnet Configuration
# Real blockchain verification with test ETH
#
# REQUIRED: Set your Infura API key before sourcing this file:
#   export INFURA_API_KEY=your_infura_api_key_here
#
# Get a free API key at: https://infura.io

# Validate INFURA_API_KEY is set
if [ -z "${INFURA_API_KEY:-}" ]; then
    echo "❌ ERROR: INFURA_API_KEY not set"
    echo "   Get your free API key at: https://infura.io"
    echo "   Then: export INFURA_API_KEY=your_key"
    return 1 2>/dev/null || exit 1
fi

export OAK_BLOCKCHAIN_MODE=sepolia
export OAK_BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/${INFURA_API_KEY}
export OAK_BLOCKCHAIN_CONTRACT_ADDRESS=0x7fcEc350268F5482D04eb4B229A0679374906732

# IPFS BlobStore (default, always enabled)
export BLOBSTORE_TYPE=ipfs
export IPFS_API_ENDPOINT=/ip4/127.0.0.1/tcp/5001

# Optional: Override contract address after deploying via Remix
# export OAK_BLOCKCHAIN_CONTRACT_ADDRESS=0xYourNewContractAddress

