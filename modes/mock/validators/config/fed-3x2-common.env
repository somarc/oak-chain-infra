# Enterprise-federation 3x2 local topology: shared defaults.
#
# Two disposable 3-member clusters, each one enterprise, federated through one static-file
# directory instead of oak.sharding.* routes. Everything lives under the federation root
# FED_3X2_ROOT (default $HOME/oak-chain-federation/3x2), which must stay outside the protected
# live root $HOME/oak-chain: sourcing this file fails for any root equal to, under, or above it.
# Cluster files override only what differs between cluster A and cluster B.

# shellcheck source=../lifecycle/lib/fed-3x2.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lifecycle/lib/fed-3x2.sh"

export OAK_CLUSTER_SIZE=3
export OAK_VALIDATOR_HTTP_PORT_STEP=2
export AERON_GLOBAL_TMP_CLEANUP=false
# The IPFS daemon is shared with every other local cluster: never auto-start one from here.
export AUTO_START_IPFS="${AUTO_START_IPFS:-false}"

export FED_3X2_ROOT="${FED_3X2_ROOT:-${HOME}/${FED_3X2_DEFAULT_ROOT_SUFFIX}}"
fed_3x2_require_safe_root "$FED_3X2_ROOT" || return 1

# Shared by both clusters; the federation smoke writes it (directoryEpoch must rise with every edit).
export FED_3X2_DIRECTORY_FILE="${FED_3X2_ROOT}/directory.json"
export FED_3X2_EVIDENCE_DIR="${FED_3X2_ROOT}/evidence"
export FED_3X2_POLL_MS="${FED_3X2_POLL_MS:-2000}"

export FED_3X2_ENTERPRISE_A=0xa1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1
export FED_3X2_ENTERPRISE_B=0xb2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2
