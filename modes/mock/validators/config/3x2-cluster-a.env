# 3x2 local sharding topology: cluster A
#
# Owns the lower wallet-prefix half and mounts cluster B read-only.

export OAK_CLUSTER_NAME=cluster-a
export OAK_CLUSTER_SIZE=3

export CLUSTER_RUNTIME_ROOT="${HOME}/oak-chain/3x2/cluster-a"
export PID_DIR="${CLUSTER_RUNTIME_ROOT}/pids"
export LOG_DIR="${CLUSTER_RUNTIME_ROOT}/logs"
export CLUSTER_WALLET_FILE="${CLUSTER_RUNTIME_ROOT}/cluster-keystore.properties"

export OAK_VALIDATOR_HTTP_BASE_PORT=8090
export OAK_VALIDATOR_HTTP_PORT_STEP=2
export AERON_CLUSTER_BASE_PORT=9000

export OPS_PROXY_PORT=8787
export OPS_PROXY_UPSTREAM="http://127.0.0.1:${OAK_VALIDATOR_HTTP_BASE_PORT}"

export EXTRA_JAVA_OPTS="-Doak.sharding.enabled=true -Doak.sharding.local.prefixes=00-7f -Doak.sharding.remote.routes=80-ff=http://127.0.0.1:8190"
