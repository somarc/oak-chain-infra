# Mock Mode Configuration
# Pure simulation - no blockchain verification, instant transactions

export OAK_BLOCKCHAIN_MODE=mock
export OAK_MOCK_EPOCH_DURATION_SECONDS=300
export OAK_CLUSTER_ENV="${OAK_CLUSTER_ENV:-test}"
export OAK_CLUSTER_SESSION_TIMEOUT_SECONDS="${OAK_CLUSTER_SESSION_TIMEOUT_SECONDS:-30}"

# IPFS BlobStore (default, always enabled)
export BLOBSTORE_TYPE=ipfs
export IPFS_API_ENDPOINT=/ip4/127.0.0.1/tcp/5001
export IPFS_GATEWAY_BASE=http://127.0.0.1:8099/ipfs/
export IPFS_LOCAL_GATEWAY_BASE=http://127.0.0.1:8099/ipfs/

# Blockchain calls are simulated locally
# IPFS still required for binary storage

# Mock-mode infra suites exercise proposal surfaces, not public-edge abuse controls.
# Disable HTTP rate limiting by default for local mock validators unless explicitly re-enabled.
export OAK_RATE_LIMIT_ENABLED="${OAK_RATE_LIMIT_ENABLED:-false}"
