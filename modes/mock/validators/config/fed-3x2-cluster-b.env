# Enterprise-federation 3x2 local topology: cluster B (enterprise 0xb2…b2).
#
# Owns no wallet prefix: what it owns comes from the committed federation directory.

# shellcheck disable=SC1090
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/fed-3x2-common.env" || return 1

export OAK_CLUSTER_NAME=fed-cluster-b
export FED_3X2_ENTERPRISE_ID="$FED_3X2_ENTERPRISE_B"

export CLUSTER_RUNTIME_ROOT="${FED_3X2_ROOT}/cluster-b"
export PID_DIR="${CLUSTER_RUNTIME_ROOT}/pids"
export LOG_DIR="${CLUSTER_RUNTIME_ROOT}/logs"
export CLUSTER_WALLET_FILE="${CLUSTER_RUNTIME_ROOT}/cluster-keystore.properties"
export AERON_DIR_BASE="${CLUSTER_RUNTIME_ROOT}/aeron-media"

export OAK_VALIDATOR_HTTP_BASE_PORT=8390
export AERON_CLUSTER_BASE_PORT=10200

export OPS_PROXY_PORT=8798
export OPS_PROXY_UPSTREAM="http://127.0.0.1:${OAK_VALIDATOR_HTTP_BASE_PORT}"

export EXTRA_JAVA_OPTS="-Doak.federation.enterpriseId=${FED_3X2_ENTERPRISE_ID} -Doak.federation.mode=mock -Doak.federation.registry=static -Doak.federation.directoryFile=${FED_3X2_DIRECTORY_FILE} -Doak.federation.pollMs=${FED_3X2_POLL_MS}"
