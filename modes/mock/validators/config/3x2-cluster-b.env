# 3x2 local sharding topology: cluster B
#
# Owns the upper wallet-prefix half and mounts cluster A read-only.

# shellcheck disable=SC1090
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/3x2-common.env"

export OAK_CLUSTER_NAME=cluster-b

export CLUSTER_RUNTIME_ROOT="${CLUSTER_B_RUNTIME_ROOT:-${HOME}/oak-chain/3x2/cluster-b}"
export PID_DIR="${CLUSTER_RUNTIME_ROOT}/pids"
export LOG_DIR="${CLUSTER_RUNTIME_ROOT}/logs"
export CLUSTER_WALLET_FILE="${CLUSTER_RUNTIME_ROOT}/cluster-keystore.properties"
export AERON_DIR_BASE="${CLUSTER_B_AERON_DIR_BASE:-${CLUSTER_RUNTIME_ROOT}/aeron-media}"

export OAK_VALIDATOR_HTTP_BASE_PORT=8190
export AERON_CLUSTER_BASE_PORT=9400

export OPS_PROXY_PORT=8788
export OPS_PROXY_UPSTREAM="http://127.0.0.1:${OAK_VALIDATOR_HTTP_BASE_PORT}"

export EXTRA_JAVA_OPTS="-Doak.sharding.enabled=true -Doak.sharding.local.prefixes=80-ff -Doak.sharding.remote.routes=00-7f=http://127.0.0.1:8090"
